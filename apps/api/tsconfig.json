{
  "extends": "@otd/config/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "sourceMap": true,
    "noUnusedParameters": false
  },
  "include": ["src"]
}
